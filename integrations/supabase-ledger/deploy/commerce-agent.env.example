# The merchant console's environment. This file holds secrets: keep it mode 600 and out
# of any repository. console.sh reads it; ledger_backend.deployment documents each name.

# Anthropic API key from platform.claude.com (usage-billed, not a Claude subscription).
ANTHROPIC_API_KEY=

# Read-only Postgres connection to the ledger: a role that can select only
# public.products and ops.channel_order_mirror.
LEDGER_DSN=

# The tenant this console serves, and how its rows read.
LEDGER_TENANT_ID=
LEDGER_TIMEZONE=UTC
LEDGER_OPTION_LABELS=
LEDGER_LOW_STOCK_THRESHOLD=3
LEDGER_ZERO_STOCK_SELLABLE=false

# The store name the agent uses and the model it runs on.
MERCHANT_BRAND_NAME=
MERCHANT_MODEL=claude-opus-5-5

# Restocks: leave both empty to run read-only. When set, an approved restock runs the
# workbench CLI's stock.set in WORKBENCH_ROOT (the checkout) for WORKBENCH_PACKAGE.
WORKBENCH_ROOT=
WORKBENCH_PACKAGE=
